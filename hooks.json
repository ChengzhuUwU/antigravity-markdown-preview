{
  "session-preview-sync": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node scripts/hook-sync.mjs",
        "timeout": 3
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node scripts/hook-sync.mjs",
        "timeout": 3
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hook-sync.mjs",
            "timeout": 3
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node scripts/hook-sync.mjs",
        "timeout": 3
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node scripts/hook-sync.mjs",
        "timeout": 3
      }
    ]
  }
}
